# Meta uses this value only during webhook URL verification.
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-value

# Meta App Dashboard > App settings > Basic > App secret.
META_APP_SECRET=replace-with-your-meta-app-secret

# Choose one delivery destination:
# 1) Recommended: the same public MySQL database used by WavePing.
DATABASE_URL=mysql://user:password@host:3306/whatsappdb

# 2) Or forward to a publicly reachable WavePing webhook instead of MySQL.
# WHATSAPP_WEBHOOK_FORWARD_URL=https://waveping.example.com/api/meta/webhook
# WHATSAPP_WEBHOOK_FORWARD_SECRET=replace-with-a-long-random-value
