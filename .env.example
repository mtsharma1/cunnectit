# Copy privately to .env on the VPS. Never commit real credentials.
DATABASE_URL="mysql://cunnectit_app:REPLACE_PASSWORD@127.0.0.1:3306/cunnectit"
META_WEBHOOK_VERIFY_TOKEN="REPLACE_WITH_EXISTING_META_VERIFY_TOKEN"
META_APP_SECRET="REPLACE_WITH_META_APP_SECRET"
GODADDY_SMTP_HOST="smtpout.secureserver.net"
GODADDY_SMTP_PORT="465"
GODADDY_SMTP_SECURE="true"
GODADDY_SMTP_USER="REPLACE_WITH_MAILBOX_ADDRESS"
GODADDY_SMTP_PASSWORD="REPLACE_WITH_MAILBOX_PASSWORD"
CONTACT_FROM_EMAIL="REPLACE_WITH_SENDER_ADDRESS"
